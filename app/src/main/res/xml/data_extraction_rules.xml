<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ (API 31+).
   Defines what data should be backed up / transferred to a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Only back up Preferences DataStore settings -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
