<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ (API 31+).

   Settings live in Preferences DataStore (files/datastore/), the scan history
   lives in the Room database, and AppCompat keeps the per-app language in
   SharedPreferences below API 33. All three are restored on a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
        <include domain="database" path="quickqr_database" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
        <include domain="database" path="quickqr_database" />
    </device-transfer>
</data-extraction-rules>
